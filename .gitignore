# etcd-walker

# Compiled binary: repo-root output of `go build` / `build-deb.sh` / `make`.
# Anchored with a leading slash so it matches ONLY the built binary and NOT
# the cmd/etcd-walker/ source directory.
/etcd-walker

# Build & packaging output dirs (Makefile): dist/ holds the release — every
# binary, the packages and SHA256SUMS; build/ holds the debs/rpms/pkgs and
# their staging trees (also build-deb.sh's output).
/dist/
/build/

# Go build, test & profiling artifacts.
*.exe
*.test
*.out
*.prof

# Runtime logs (e.g. etcd-walker.log).
*.log

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
# (.vscode/ is NOT ignored: the shared tasks.json is tracked on purpose.)

# Local state of coding-assistant tooling (Serena's memories and project
# config, Claude Code's per-user settings). Personal, never project source.
.serena/
.claude/settings.local.json

# coverage output from `make cover` / CI, and the HTML report
# `go tool cover -html=coverage.out -o coverage.html` writes next to it.
coverage.out
coverage.html

# Local Go tooling state: a `go.work` used to point the module at a checkout
# elsewhere, and `go mod vendor` output. Neither belongs to the project.
go.work
go.work.sum
/vendor/

# End-to-end suite (test/e2e). run.sh keeps its certificates, state dir and
# logs in a mktemp dir it removes; these cover running e2e.py directly: the
# binary `make e2e-bin` builds, per-scenario stderr captures, the default
# certificate and undo-snapshot dirs, and Python's bytecode cache.
/test/e2e/etcd-walker
/test/e2e/*.stderr
/test/e2e/certs/
/test/e2e/state/
/test/e2e/__pycache__/

# README screenshot tooling (tools/screenshots): the binary copied in, the
# raw ANSI captures, and the per-run state/stderr it leaves behind.
/tools/screenshots/etcd-walker
/tools/screenshots/*.ansi
/tools/screenshots/state/
/tools/screenshots/shots.err
