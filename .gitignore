# etcd-walker

# Compiled binary: repo-root output of `go build` / `build-deb.sh` / `make`.
# Anchored with a leading slash so it matches ONLY the built binary and NOT
# the cmd/etcd-walker/ source directory.
/etcd-walker

# Build & packaging output dirs (Makefile: DIST_DIR / BUILD_DIR).
/dist/
/build/

# Go build, test & profiling artifacts.
*.exe
*.test
*.out
*.prof

# Runtime logs (e.g. etcd-walker.log).
*.log

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# coverage output from `make cover` / CI, and the HTML report
# `go tool cover -html=coverage.out -o coverage.html` writes next to it.
coverage.out
coverage.html

# Local Go tooling state: a `go.work` used to point the module at a checkout
# elsewhere, and `go mod vendor` output. Neither belongs to the project.
go.work
go.work.sum
/vendor/
